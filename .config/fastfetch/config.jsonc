
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/ascii/charizard-mega-X.png",
    "width": 25,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 0
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "vipool@fedora"
    },
    "break",
    {
      "type": "custom",
      "format": "╭────────────╮"
    },
    {
      "type": "os",
      "key": "│ OS         │",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "│ Kernel     │"
    },
    {
      "type": "uptime",
      "key": "│ Uptime     │"
    },
    {
      "type": "shell",
      "key": "│ Shell      │"
    },
    {
      "type": "de",
      "key": "│ DE         │"
    },
    {
      "type": "terminal",
      "key": "│ Terminal   │"
    },
    {
      "type": "custom",
      "format": "├────────────┤"
    },
    {
      "type": "memory",
      "key": "│ Memory     │"
    },
    {
      "type": "disk",
      "key": "│ Disk       │"
    },
    {
      "type": "custom",
      "format": "╰────────────╯"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "\u001b[38;2;30;58;95m●  \u001b[38;2;42;82;130m●  \u001b[38;2;54;110;165m●  \u001b[38;2;65;140;195m●  \u001b[38;2;82;170;220m●  \u001b[38;2;105;195;240m●  \u001b[38;2;145;215;250m●  \u001b[38;2;190;235;255m●\u001b[0m"
    },
    "break"
  ]
}

