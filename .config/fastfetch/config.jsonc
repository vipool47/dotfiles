
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/ascii/charizard-mega-X.png",
    "width": 25,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 10
    }
  },
  "modules": [
    "break",
    "title",
    "separator",
    {
      "type": "os",
      "format": "{2}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "de",
      "key": "DE"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    "memory",
    "disk",
    "break"
  ]
}
